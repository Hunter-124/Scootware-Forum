# Nginx Production Configuration for Scootware Forum
# Deploy to VPS: /etc/nginx/sites-available/scootware
# Enable: sudo ln -s /etc/nginx/sites-available/scootware /etc/nginx/sites-enabled/scootware
# Test: sudo nginx -t
# Reload: sudo systemctl reload nginx

upstream scootware_api {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80 default_server;
    
    server_name _;
    
    # Redirect HTTP to HTTPS (if SSL is configured)
    # Uncomment when SSL is set up:
    # return 301 https://$server_name$request_uri;
    
    # For now, serve HTTP directly
    root /home/admin/Scootware-Forum/artifacts/forum/dist/public;
    index index.html;
    
    # Gzip compression for better performance
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_vary on;
    gzip_comp_level 6;
    
    # Static file caching (assets)
    location ~* ^/assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
    }
    
    # Long-term cache for hashed assets
    location ~* \.(js|css|woff|woff2|ttf|eot|svg|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
    }
    
    # API proxy - pass to Node.js backend
    location /api/ {
        proxy_pass http://scootware_api;
        proxy_http_version 1.1;
        
        # Preserve headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    # Uploaded files
    location /uploads/ {
        alias /home/admin/Scootware-Forum/uploads/;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }
    
    # SPA fallback - serve index.html for all unknown routes
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # Deny access to sensitive files
    location ~ /\.env {
        deny all;
    }
    
    location ~ /\.git {
        deny all;
    }
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
}

# HTTPS server block for Cloudflare Full/Strict SSL mode
    # Ensure certificates exist at the paths below (Let's Encrypt / Certbot)
    server {
        listen 443 ssl http2;

        server_name scootware.us www.scootware.us;

        ssl_certificate /etc/letsencrypt/live/scootware.us/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/scootware.us/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

        root /home/admin/Scootware-Forum/artifacts/forum/dist/public;
        index index.html;

        location ~* ^/assets/ {
            expires 30d;
            add_header Cache-Control "public, immutable";
            add_header X-Content-Type-Options "nosniff";
            access_log off;
        }

        location ~* \.(js|css|woff|woff2|ttf|eot|svg|map)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            add_header X-Content-Type-Options "nosniff";
            access_log off;
        }

        location /api/ {
            proxy_pass http://scootware_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 8 4k;
        }

        location /uploads/ {
            alias /home/admin/Scootware-Forum/uploads/;
            expires 30d;
            add_header Cache-Control "public";
            access_log off;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }

        location ~ /\.(env|git) {
            deny all;
        }

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "no-referrer-when-downgrade" always;
    }

    # Redirect HTTP to HTTPS
    server {
        listen 80;
        server_name scootware.us www.scootware.us;
        return 301 https://$host$request_uri;
    }

    # Optional: HTTP/2 with SSL
    # ... (this block is kept for reference, no action needed)
