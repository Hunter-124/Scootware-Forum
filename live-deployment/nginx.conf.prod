# Nginx Production Configuration for Scootware Forum
# Deploy to VPS: /etc/nginx/sites-available/scootware
# Enable: sudo ln -s /etc/nginx/sites-available/scootware /etc/nginx/sites-enabled/scootware
# Test: sudo nginx -t
# Reload: sudo systemctl reload nginx

upstream scootware_api {
    server 127.0.0.1:3000;
    keepalive 64;
}

# IMPORTANT: This default HTTP server handles ALL requests that don't match domain names
# It accepts both IP address and domain name requests
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    
    server_name _;
    
    # Serve static files and SPA frontend
    root /home/admin/Scootware-Forum/artifacts/forum/dist/public;
    index index.html;
    
    # Increase client body size for file uploads (1GB)
    client_max_body_size 1G;
    
    # Gzip compression for better performance
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_vary on;
    gzip_comp_level 6;
    
    # Static file caching (assets)
    location ~* ^/assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
    }
    
    # Versioned/hashed assets - long-term cache
    location ~* \.(js|css|woff|woff2|ttf|eot|svg|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
    }
    
    # API proxy - forward to Node.js backend on port 3000
    location /api/ {
        client_max_body_size 1G;
        proxy_pass http://scootware_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    # Uploaded user files (avatars, etc.)
    location /uploads/ {
        alias /home/admin/Scootware-Forum/uploads/;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }
    
    # SPA single-page application fallback
    # All unknown routes serve index.html so React Router can handle them
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # Deny access to sensitive files
    location ~ /\.env {
        deny all;
        access_log off;
    }
    
    location ~ /\.git {
        deny all;
        access_log off;
    }
    
    location ~ /\.ht {
        deny all;
        access_log off;
    }
    
    # Security headers - always applied
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
}

# OPTIONAL: Domain-specific HTTP to HTTPS redirect
# Only used if domain-specific SSL is needed (e.g., via Let's Encrypt for scootware.us)
# Uncomment this section if you set up SSL certificates at /etc/letsencrypt/live/scootware.us/

server {
    listen 80;
    listen [::]:80;
    server_name scootware.us www.scootware.us;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name scootware.us www.scootware.us;
    ssl_certificate /etc/letsencrypt/live/scootware.us/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scootware.us/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    
    root /home/admin/Scootware-Forum/artifacts/forum/dist/public;
    index index.html;

    # Increase client body size for file uploads (1GB)
    client_max_body_size 1G;

    # Gzip compression for better performance
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_vary on;
    gzip_comp_level 6;

    # Static file caching (assets)
    location ~* ^/assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
    }

    # Versioned/hashed assets - long-term cache
    location ~* \.(js|css|woff|woff2|ttf|eot|svg|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
    }

    # API proxy - forward to Node.js backend on port 3000
    location /api/ {
        client_max_body_size 1G;
        proxy_pass http://scootware_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    # Uploaded user files (avatars, etc.)
    location /uploads/ {
        alias /home/admin/Scootware-Forum/uploads/;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    # SPA single-page application fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Deny access to sensitive files
    location ~ /\.env {
        deny all;
        access_log off;
    }

    location ~ /\.git {
        deny all;
        access_log off;
    }

    location ~ /\.ht {
        deny all;
        access_log off;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
}
