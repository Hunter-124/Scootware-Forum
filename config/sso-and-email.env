# ============================================================
# Scootware Forum - SSO & Email Configuration
# ============================================================
# Place your real credentials below and load this file into
# your environment (e.g., source config/sso-and-email.env)
# before starting the server, or copy values into your hosting
# provider's environment variables panel.
#
# NEVER commit this file with real secrets to source control.
# ============================================================

# ------ Session Secret ----------------------------------------
# Random 64-char string. Generate: openssl rand -hex 32
SESSION_SECRET=replace_with_a_secure_random_string

# ------ Google OAuth 2.0 ---------------------------------------
# Create at: https://console.developers.google.com/
# Authorized redirect URI: https://yourdomain.com/api/auth/sso/google/callback
GOOGLE_CLIENT_ID=[YOUR_GOOGLE_CLIENT_ID]
GOOGLE_CLIENT_SECRET=[YOUR_GOOGLE_CLIENT_SECRET]
GOOGLE_CALLBACK_URL=https://scootware.us/api/auth/sso/google/callback

# ------ Discord OAuth2 -----------------------------------------
# Create at: https://discord.com/developers/applications
# Redirect URI: https://yourdomain.com/api/auth/sso/discord/callback
DISCORD_CLIENT_ID=1487692664643256420
DISCORD_CLIENT_SECRET=T0dPpRUJxTdu92rwb59aeaK6qcnSlu8a
DISCORD_CALLBACK_URL=https://scootware.us/api/auth/sso/discord/callback

# ------ Steam OpenID -------------------------------------------
# Realm: https://yourdomain.com
# No client secret needed for Steam (uses OpenID 2.0)
STEAM_API_KEY=AE4EADB8217450B5CD8182F7F4E5AE6B
STEAM_REALM=https://scootware.us
STEAM_CALLBACK_URL=https://scootware.us/api/auth/sso/steam/callback

# ------ Email (SMTP) -------------------------------------------
# For Gmail: use an App Password (not your main password)
# For SendGrid: set SMTP_HOST=smtp.sendgrid.net SMTP_USER=apikey SMTP_PASS=<api_key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=jgnt npvs yuxb nzxi
SMTP_FROM=noreply@scootware.us
SMTP_FROM_NAME=Scootware

# ------ Database (auto-set by Replit or your host) -------------
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ------ Site URL (used for links in emails) --------------------
SITE_URL=https://scootware.us
