# ============================================================
# Scootware Forum - Crypto Payment Configuration
# ============================================================
# Add your real wallet addresses and API keys below.
# Load this file alongside sso-and-email.env:
#   source config/crypto-payments.env
#
# NEVER commit this file with real wallet addresses or API
# keys to source control.
# ============================================================

# ------ Crypto Wallet Addresses ----------------------------
# These are the PUBLIC addresses users will send funds to.
# Generate a separate receiving address for each coin in your
# wallet software or exchange.

CRYPTO_BTC_WALLET=[YOUR_BTC_WALLET_ADDRESS]
CRYPTO_ETH_WALLET=[YOUR_ETH_WALLET_ADDRESS]
CRYPTO_LTC_WALLET=[YOUR_LTC_WALLET_ADDRESS]
CRYPTO_USDT_ERC20_WALLET=[YOUR_USDT_WALLET_ADDRESS]
CRYPTO_USDC_ERC20_WALLET=[YOUR_USDC_WALLET_ADDRESS]
# Standardized wallet variable names for backend compatibility:
CRYPTO_USDT_WALLET=[YOUR_USDT_WALLET_ADDRESS]
CRYPTO_USDC_WALLET=[YOUR_USDC_WALLET_ADDRESS]
CRYPTO_SOL_WALLET=[YOUR_SOL_WALLET_ADDRESS]

# ------ Etherscan API Key ----------------------------------
# Required for ETH and USDT-ERC20 transaction monitoring.
# Get a FREE key at: https://etherscan.io/apis
# BTC uses Blockstream.info (no key required)
# LTC uses litecoinspace.org (no key required)
ETHERSCAN_API_KEY=[YOUR_ETHERSCAN_API_KEY]
